{
    "manifest_version": 3,
    "name": "ContApp SPV",
    "version": "1.0.0",
    "description": "Permite ContApp să citească mesajele din SPV ANAF folosind certificatul digital din browser.",
    "permissions": ["cookies"],
    "host_permissions": ["*://webserviced.anaf.ro/*", "*://anaf.ro/*"],
    "minimum_chrome_version": "119",
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://account.contapp.ro/*",
                "https://contabilitate.contapp.ro/*",
                "https://declaratiaunica.contapp.ro/*",
                "https://account.contapp.test/*",
                "https://contabilitate.contapp.test/*",
                "https://declaratiaunica.contapp.test/*"
            ],
            "js": ["content.js"],
            "run_at": "document_start"
        }
    ],
    "icons": {
        "16": "icons/icon-16.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "spv@contapp.ro",
            "strict_min_version": "140.0"
        }
    }
}
