{
    "manifest_version": 3,
    "name": "ContApp",
    "version": "1.0.0",
    "description": "Permite ContApp să folosească serviciile ANAF (mesaje SPV, depunerea declarațiilor) cu certificatul digital din browser.",
    "permissions": ["cookies"],
    "incognito": "not_allowed",
    "host_permissions": ["*://webserviced.anaf.ro/*", "*://anaf.ro/*", "*://decl.anaf.mfinante.gov.ro/*"],
    "minimum_chrome_version": "119",
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://account.contapp.ro/*",
                "https://contabilitate.contapp.ro/*",
                "https://declaratiaunica.contapp.ro/*",
                "https://*.contapp.test/*",
                "https://contapp.test/*"
            ],
            "js": ["content.js"],
            "run_at": "document_start"
        },
        {
            "matches": [
                "https://decl.anaf.mfinante.gov.ro/my.policy*",
                "https://decl.anaf.mfinante.gov.ro/WAS6DUS/*",
                "https://decl.anaf.mfinante.gov.ro/vdesk/hangup.php3*",
                "https://webserviced.anaf.ro/SPVWS2/rest/*",
                "https://webserviced.anaf.ro/vdesk/hangup.php3*"
            ],
            "js": ["login-tab.js"],
            "run_at": "document_idle"
        }
    ],
    "icons": {
        "16": "icons/icon-16.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "spv@contapp.ro",
            "strict_min_version": "140.0"
        }
    }
}
